# Copy this file to server/.env and fill in the values.

# REPLACE ME: your LaunchDarkly *server-side SDK key* (starts with "sdk-").
# Find it under: Organization settings > Projects > <your project> > Environments > "SDK key"
# Keep it secret - it is for server-side code only and must never ship to a browser.
LD_SDK_KEY=

# OPTIONAL: a LaunchDarkly *flag trigger* URL for the "insights-dashboard" flag with the
# action "Turn flag off". Used by `npm run remediate` (scripts/remediate.sh), the manual
# kill switch via curl. Automatic remediation is LaunchDarkly's guarded rollout (README).
# How to create one: open the flag > "..." menu on the environment > Configuration in
# environment > Triggers > + Add trigger > Trigger type: Generic trigger > Action: Turn flag off.
# The URL is shown ONCE - copy it immediately. Treat it like a password.
LD_TRIGGER_URL=

# OPTIONAL: the environment's *client-side ID* (same value as client/.env). Lets the API's
# observability logs carry feature_flag.set.id, matching LaunchDarkly's own evaluation events.
LD_ENVIRONMENT_ID=

# Port for the Express API (API_PORT, not PORT, so other tools that set PORT don't interfere).
API_PORT=3001

# --- Only needed for the REST API scripts (scripts/remediate-api.sh, scripts/setup-part2-targeting.sh) ---
# remediate-api.sh is the fallback if your plan has no flag triggers; setup-part2-targeting.sh
# applies the Part 2 targeting rules without clicking through the UI.
# LD_API_TOKEN: Organization settings > Authorization > Create token (Writer role is enough)
# LD_API_TOKEN=
# LD_PROJECT_KEY=abc-company
# LD_ENV_KEY=production
